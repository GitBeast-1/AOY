{
  "manifest_version": 3,
  "name": "Art OF YouTube (AOY) - Thumb & Outlier Copilot",
  "version": "1.2.0",
  "description": "1-click copy & sync YouTube video thumbnails, titles, channel data, views, and metrics directly to your AOY Faceless Studio Thumbs preview deck.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.run.app/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AOY YouTube Thumb & Outlier Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
